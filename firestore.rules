rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se é Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'adminnutlyar@gmail.com' ||
        get(/databases/$(database)/documents/utilizadores/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/utilizadores/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // PERMISSÃO ABERTA PARA O PERÍODO DE TESTES DA TESE
    // Permite que qualquer utilizador autenticado (ou a app) grave e leia as coleções do estudo
    match /utilizadores/{document} {
      allow read, write: if true;
    }
    
    match /demographics/{document} {
      allow read, write: if true;
    }

    match /nutly_sessions/{document} {
      allow read, write: if true;
    }

    match /nutly_image_sessions/{document} {
      allow read, write: if true;
    }

    match /quiz_sessions/{document} {
      allow read, write: if true;
    }

    match /question/{document} {
      allow read, write: if true;
    }

    // Bloqueia qualquer outra coleção desconhecida por segurança externa
    match /{document=**} {
      allow read, write: if request.auth != null || isAdmin();
    }
  }
}